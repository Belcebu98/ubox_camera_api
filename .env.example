# Plantilla publica. No sobrescribir un .env existente ni publicar credenciales.
# npm start: API + visor + grabador automatico. start:legacy conserva el servidor anterior.
email=your_email
password=your_password
server_port=8020
# Loopback por defecto. 0.0.0.0 permite LAN; no hay autenticacion propia.
server_host=127.0.0.1
debug_mode=false
stream_log_console=false
# Solo server.js legacy; el integrado siempre guarda logs y no vuelca video crudo.
stream_log_file=true
stream_dump_video=false

# Video en el HDD. Nuevos tramos bajo continuo/UID/fecha. No se mueve el historial.
recording_dir=E:/camaras
# Estado privado: rutas relativas resueltas desde la raiz del proyecto, no desde la terminal.
# Deben estar fuera de recording_dir. No publicar estas carpetas en Git.
metadata_dir=./data/recordings
camera_logs_dir=./logs/cameras
app_logs_dir=./logs/app
# Destino reservado para diagnosticos. La sonda antigua usa _diagnostics en recording_dir;
# no ejecutarla hasta migrar su destino si se requiere mantener el HDD libre de JSON.
diagnostics_dir=./data/diagnostics
# Reserva para el futuro estado de descargas SD; descarga aun no implementada.
downloads_state_dir=./data/downloads

# Una camara grabando. Vacio solo si hay exactamente una en la cuenta. No admite listas.
recording_camera_uid=
# Indice 0..3; no es un modo HD verificado.
recording_stream_index=0
# Temporizacion fija del MP4: verificar velocidad real de la grabacion.
recording_fps=15
# Objetivo 10..3600 segundos; corte al siguiente fotograma clave.
recording_segment_seconds=600
# Reserva en GiB. Pausa bajo el umbral; no borra archivos.
recording_min_free_gb=1000
# FPS del HLS recodificado para el directo.
hls_fps=15
# Bateria de nube: intervalo 60..86400 segundos. Puede ser informacion cacheada.
battery_poll_seconds=60
# Aviso visual 0..100; no detiene la grabacion ni controla la carga solar.
battery_low_percent=20
# RTSP heredado no cargado por el arranque actual: no lo habilita esta variable.
rtsp_port=8022
