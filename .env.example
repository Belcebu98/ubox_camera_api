# PLANTILLA PUBLICA: copia los ajustes necesarios a tu .env, no lo sobrescribas.
# No publiques email, password, tokens ni el .env real.
# npm start: API, web, grabacion automatica y bateria en UN proceso/puerto.
# npm run start:legacy: servidor anterior. No ejecutar ambos en el mismo puerto.

# Cuenta UBox con acceso a las camaras.
email=your_email
password=your_password

# Puerto HTTP del servicio integrado y del enlace interno usado por FFmpeg.
server_port=8020
# Solo este PC. Para LAN: 0.0.0.0. No hay autenticacion propia: no exponer a Internet.
server_host=127.0.0.1
# Debug de helpers/UBox; false reduce el ruido de consola.
debug_mode=false
# Mostrar cada evento del stream en terminal. Puede producir mucha salida.
# El servicio integrado guarda eventos en stream-logs independientemente de esto.
stream_log_console=false
# Solo start:legacy: registros de sesion en archivos. El integrado siempre registra.
stream_log_file=true
# Solo start:legacy: volcados crudos de diagnostico. No son las grabaciones MP4.
# El integrado no usa esta opcion; no activarla para grabar.
stream_dump_video=false

# HDD para grabaciones. E:/camaras equivale a E:\camaras en Windows.
# No se eliminan archivos antiguos automaticamente.
recording_dir=E:/camaras
# UID exacto de la UNICA camara que graba esta instancia.
# Vacio: seleccion automatica solo si la cuenta tiene exactamente una camara.
# Si hay varias, rellenar. NO admite listas de UIDs separadas por comas.
# El panel de bateria si identifica varias camaras; no implica grabacion simultanea.
recording_camera_uid=
# Indice de stream solicitado (0..3). No es una equivalencia HD verificada.
recording_stream_index=0
# FPS para temporizar el MP4. Verificar velocidad contra la fuente real.
# No aumenta FPS, resolucion ni detalle de la camara.
recording_fps=15
# Duracion objetivo en segundos (10..3600); corta al siguiente fotograma clave.
# Nombres: fecha/hora local del servidor al iniciar cada tramo, no hora de descarga.
recording_segment_seconds=300
# Reserva libre en GiB; comprobada cada cinco segundos. Si falta espacio se pausa.
# No borra grabaciones. Para un HDD grande puede aumentarse, por ejemplo a 10.
recording_min_free_gb=2

# FPS del HLS recodificado para el directo; independiente del MP4 original.
hls_fps=15
# Consultas de bateria a device_list: segundos entre intentos (60..86400).
# Navegadores leen cache local. Consultado ahora NO equivale a medido ahora.
battery_poll_seconds=300
# Umbral de AVISO VISUAL (0..100). No pausa/reanuda grabacion ni controla carga solar.
battery_low_percent=20

# Modulo RTSP heredado, NO cargado por los modos actuales. Esto no habilita RTSP.
rtsp_port=8022
# Opcionales solo para ejecucion explicita del modulo RTSP:
# rtsp_publish_port=8023
# rtsp_rtp_port_start=10000
# rtsp_rtp_port_count=200
# rtsp_canvas_width=1920
# rtsp_canvas_height=1080
# hls_canvas_width/height ya no se leen en el puente HLS actual.

# LIMITES: una camara grabando, H.264, sin audio, sin borrado automatico.
# No hay politica de ahorro solar: validar bateria durante captura continua.
# Multicamara simultanea requiere ampliar el gestor y las rutas de video.
